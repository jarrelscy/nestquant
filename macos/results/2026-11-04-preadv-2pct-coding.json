  "test_source": "import hashlib\nimport json\nfrom pathlib import Path\nimport random\nimport re\n\nfrom generated_palindrome import is_palindrome\n\ncases = [('A man, a plan, a canal: Panama!', True), ('race a car', False), ('', True),\n         ('!!! ', True), ('a', True), ('Abba', True), ('abc', False), ('12321', True),\n         ('12341', False), ('No lemon, no melon', True), ('\u00c0b\u00e0', True), ('ab', False)]\nrng = random.Random(42)\nfor _ in range(200):\n    value = ''.join(rng.choice('abcABC0123 ,.!') for _ in range(rng.randrange(60)))\n    cleaned = re.sub('[^a-z0-9]', '', value.lower())\n    left, right = 0, len(cleaned) - 1\n    expected = True\n    while left < right:\n        if cleaned[left] != cleaned[right]:\n            expected = False\n            break\n        left += 1\n        right -= 1\n    cases.append((value, expected))\nfor index, (value, expected) in enumerate(cases):\n    actual = is_palindrome(value)\n    assert type(actual) is bool and actual == expected, (index, value, expected, actual)\nroot = Path(__file__).resolve().parent\nreport = dict(status='passed', cases=len(cases), hand_checked_cases=12, seeded_ascii_cases=200, seed=42,\n              generated_source_sha256=hashlib.sha256((root/'generated_palindrome.py').read_bytes()).hexdigest(),\n              scope='One complete generated palindrome function, not a coding benchmark suite')\n(root/'coding-preadv-calibration-2pct-tests.json').write_text(json.dumps(report, indent=2)+'\\n')\nprint(json.dumps(report))\n",
